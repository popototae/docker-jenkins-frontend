{
  "name": "docker-jenkins-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --turbopack",
    "start": "next start -p 3000",
    "lint": "eslint",
    "test": "jest",
    "test:browser": "playwright test --project=live-api",
    "test:browser:ui": "playwright test --project=live-api --ui",
    "test:browser:headed": "playwright test --project=live-api --headed --workers=1",
    "test:browser:mock": "playwright test --config=playwright.mock.config.js",
    "test:browser:mock:ui": "playwright test --config=playwright.mock.config.js --ui",
    "test:browser:live": "playwright test --project=live-api",
    "test:browser:report": "playwright show-report"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    }
  }
}
